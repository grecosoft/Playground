<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<packageSources>
		<clear />
		<add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
		<add key="github" value="https://nuget.pkg.github.com/grecosoft/index.json" />
	</packageSources>
</configuration>
  <packageSourceCredentials>
    <github>
      <add key="Username" value="github" />
      <add key="ClearTextPassword" value="%READ_PACKAGE_TOKEN%" />
    </github>
  </packageSourceCredentials>

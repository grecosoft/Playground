{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "AgentPingResponse": {
      "$id": "#/definitions/AgentPingResponse",
      "type": "object",
      "title": "AgentPingResponse",
      "required": ["message", "status"],
      "properties": {
        "message": {
          "type": "string",
          "description": "The echoed or response message."
        },
        "status": {
          "type": "string",
          "description": "The status of the ping response."
        }
      },
      "additionalProperties": false
    },
    "AgentPingCommand": {
      "$id": "#/definitions/AgentPingCommand",
      "type": "object",
      "title": "AgentPingCommand",
      "required": ["companyId", "agentId", "echoMessage"],
      "properties": {
        "companyId": {
          "type": "string",
          "format": "uuid",
          "description": "The unique identifier of the company."
        },
        "agentId": {
          "type": "string",
          "description": "The unique identifier of the agent."
        },
        "echoMessage": {
          "type": "string",
          "description": "The message to be echoed back by the agent."
        }
      },
      "additionalProperties": false
    }
  },
  "$ref": "#/definitions/AgentPingCommand"
}
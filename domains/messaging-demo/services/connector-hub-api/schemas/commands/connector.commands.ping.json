{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$defs": {
    "ConnectorPingResponse": {
      "type": "object",
      "title": "ConnectorPingResponse",
      "required": ["message", "status"],
      "properties": {
        "message": {
          "type": "string",
          "description": "The echoed or response message."
        },
        "status": {
          "type": "string",
          "description": "The status of the ping response."
        }
      },
      "additionalProperties": false
    },
    "ConnectorPingCommand": {
      "type": "object",
      "title": "ConnectorPingCommand",
      "required": ["connectorId", "echoMessage"],
      "properties": {
        "connectorId": {
          "type": "string",
          "format": "uuid",
          "description": "The unique identifier of the connector."
        },
        "echoMessage": {
          "type": "string",
          "description": "The message to be echoed back by the connector."
        }
      },
      "additionalProperties": false
    }
  }
}